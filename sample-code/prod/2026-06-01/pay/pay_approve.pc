/******************************************************************
 * 프로그램명 : pay_approve.pc
 * 기      능 : 결제 승인 요청 처리
 * 작   성   일: 2026-05-20
 ******************************************************************/
#include <stdio.h>
#include <string.h>
#include "pay_common.h"

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
    char   h_pay_no[11];
    char   h_acct_no[12];
    double h_pay_amt;
    char   h_pay_stat[4];
EXEC SQL END DECLARE SECTION;

/* 결제 금액 검증 */
static int chk_pay_amt(double amt)
{
    if (amt <= 0) return ERR_PAY_AMT;
    return RC_OK;
}

/* 결제 승인 */
int pay_approve(PAY_REQ *req, PAY_RES *res)
{
    int rc;

    strcpy(h_acct_no, req->acct_no);
    h_pay_amt = req->pay_amt;

    rc = chk_pay_amt(h_pay_amt);
    if (rc != RC_OK) return rc;

    EXEC SQL
        SELECT LPAD(SQ_PAY_NO.NEXTVAL, 10, '0')
          INTO :h_pay_no
          FROM DUAL;

    if (sqlca.sqlcode != 0) return ERR_DB;

    EXEC SQL
        INSERT INTO TB_PAY (
            PAY_NO, ACCT_NO, PAY_AMT, PAY_STAT, REG_DTM
        ) VALUES (
            :h_pay_no, :h_acct_no, :h_pay_amt, 'APR',
            TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS')
        );

    if (sqlca.sqlcode != 0) {
        EXEC SQL ROLLBACK;
        return ERR_DB;
    }

    EXEC SQL COMMIT;

    strcpy(res->pay_no, h_pay_no);
    res->rc = RC_OK;
    return RC_OK;
}
