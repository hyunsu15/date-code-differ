/******************************************************************
 * 프로그램명 : cmm_log.pc
 * 기      능 : 공통 로그 기록
 * 변   경   일: 2026-07-22  로그 레벨 필터 추가
 ******************************************************************/
#include <stdio.h>
#include <string.h>
#include <time.h>
#include "cmm_log.h"

static FILE *g_fp    = NULL;
static int   g_level = LOG_LV_INFO;

/* 레벨 문자열 → 숫자 */
static int level_of(const char *level)
{
    if (strcmp(level, "DEBUG") == 0) return LOG_LV_DEBUG;
    if (strcmp(level, "INFO")  == 0) return LOG_LV_INFO;
    if (strcmp(level, "WARN")  == 0) return LOG_LV_WARN;
    if (strcmp(level, "ERROR") == 0) return LOG_LV_ERROR;
    return LOG_LV_INFO;
}

/* 로그 파일 열기 */
int log_open(const char *path)
{
    g_fp = fopen(path, "a");
    if (g_fp == NULL) return -1;
    return 0;
}

/* 출력 최소 레벨 설정 */
void log_set_level(int level)
{
    g_level = level;
}

/* 로그 기록 */
void log_write(const char *level, const char *msg)
{
    time_t     now;
    struct tm *tm_now;
    char       buf[20];

    if (g_fp == NULL) return;
    if (level_of(level) < g_level) return;

    time(&now);
    tm_now = localtime(&now);
    strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", tm_now);

    fprintf(g_fp, "[%s][%-5s] %s\n", buf, level, msg);
    fflush(g_fp);
}

/* 로그 파일 닫기 */
void log_close(void)
{
    if (g_fp != NULL) {
        fclose(g_fp);
        g_fp = NULL;
    }
}
