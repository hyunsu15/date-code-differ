# schema-dump.sh 설정 — 이 파일은 예시이고, 실제 값은 change/schema-dump.env 에 넣는다.
# change/schema-dump.env 는 서버 주소 · 계정이 들어가므로 커밋하지 않는다 (.gitignore).
# 없으면 schema-dump.sh 가 이 파일을 복사해 만들어 주고 멈춘다.
#
# bash 가 그대로 읽는 파일이다 — `이름="값"` 형태로, = 양옆에 공백을 두지 않는다.
# DB 비밀번호는 여기에 넣지 않는다. 실행할 때마다 묻는다.

# ── SSH — 덤프 파일을 올릴 서버 ────────────────────────────────────────
SSH_HOST="dev-server"
SSH_USER="deploy"
# 비우면 22
SSH_PORT=""
# 개인키 경로. 비우면 ~/.ssh 의 기본 키 · ssh-agent 를 쓴다
SSH_IDENTITY=""

# ── 파일 이름 규칙 ─────────────────────────────────────────────────────
# change/config.ts 의 SCHEMA.fileName 과 같아야 화면이 날짜를 읽는다
FILE_NAME="snapshot_{env}_{date}.txt"

# ── 환경마다 한 묶음 ───────────────────────────────────────────────────
# 변수 이름 앞에 환경 이름을 대문자로 붙인다.  shl/schema-dump.sh prod  → PROD_*
# 환경 이름은 파일 이름의 {env} 에 들어가므로 change/config.ts ENV_FOLDERS 의 path 와 맞춘다.
#
#   DB_CONNECT  host:port/서비스명 (Easy Connect). tnsnames 별칭을 쓰려면 TNS_ADMIN 을 export 해 둔다
#   DB_USER     접속 계정
#   DB_OWNER    볼 테이블의 소유자. change/check_table.sql 의 &owner 로 들어간다. 비우면 접속 계정
#   REMOTE_DIR  올릴 서버 폴더 = 프리셋의 schemaRoot/환경폴더. ~ 로 시작하면 서버 계정의 홈 기준

PROD_DB_CONNECT="prod-db:1521/ORCL"
PROD_DB_USER="APP"
PROD_DB_OWNER=""
PROD_REMOTE_DIR="~/schema/prod"

TEST_DB_CONNECT="test-db:1521/ORCL"
TEST_DB_USER="APP"
TEST_DB_OWNER=""
TEST_REMOTE_DIR="~/schema/test"
