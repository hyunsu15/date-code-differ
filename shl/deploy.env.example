# deploy.sh · deploy-rollback.sh 설정 — 이 파일은 예시이고, 실제 값은 change/deploy.env 에 넣는다.
# change/deploy.env 는 서버 주소 · 계정이 들어가므로 커밋하지 않는다 (.gitignore).
# 없으면 deploy.sh · deploy-rollback.sh 가 이 파일을 복사해 만들어 주고 멈춘다.
#
# bash 가 그대로 읽는 파일이다 — `이름="값"` 형태로, = 양옆에 공백을 두지 않는다.

# ── SSH — 배포할 서버 ──────────────────────────────────────────────────
SSH_HOST="app-server"
SSH_USER="deploy"
# 비우면 22
SSH_PORT=""
# 개인키 경로. 비우면 ~/.ssh 의 기본 키 · ssh-agent 를 쓴다
SSH_IDENTITY=""

# ── 빌드 — 내 PC 에서 실행한다 ────────────────────────────────────────
BUILD_CMD="npm run build"
# 빌드를 실행할 폴더 · 옮길 것을 찾을 폴더. 비우면 저장소 루트. 상대 경로는 저장소 루트 기준
BUILD_DIR=""

# ── 옮길 것 — BUILD_DIR 기준 이름, 공백으로 나눈다 ────────────────────
# 폴더 · 파일 모두 된다. 맨 위 단계 이름만 받는다 (a/b 처럼 / 가 든 것은 안 됨).
# 서버에서 같은 이름은 통째로 바뀐다. update.sh · rollback.sh 도 같이 보내 서버 쪽을 늘 최신으로 둔다.
DEPLOY_FILES="dist_next backend_next update.sh rollback.sh"

# ── 서버 ───────────────────────────────────────────────────────────────
# 올릴 폴더 = update.sh 를 둘 운영 폴더. ~ 로 시작하면 서버 계정의 홈 기준
REMOTE_DIR="~/code-diff"
# 옮긴 뒤 REMOTE_DIR 에서 실행할 명령. 원격 셸이 그대로 해석한다 (&& · ; 를 써도 된다).
# 비우면 옮기기만 한다. 예: "bash update.sh && pm2 restart code-diff"
REMOTE_CMD="bash update.sh"
# shl/deploy-rollback.sh 가 REMOTE_DIR 에서 실행할 명령. 예: "bash rollback.sh && pm2 restart code-diff"
ROLLBACK_CMD="bash rollback.sh"
